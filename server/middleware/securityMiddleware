const rateLimit = require("express-rate-limit");
const xss = require("xss");

const SENSITIVE_KEYS = new Set([
  "password",
  "currentpassword",
  "newpassword",
  "confirmpassword",
  "token",
  "refreshtoken",
  "accesstoken",
  "authorization",
]);

const BLOCKED_KEYS = new Set(["__proto__", "prototype", "constructor"]);

const MAX_DEPTH = 8;
const MAX_STRING_LENGTH = 5000;

const isSensitiveKey = (key) => {
  return SENSITIVE_KEYS.has(String(key || "").toLowerCase());
};

const isBlockedKey = (key) => {
  const cleanKey = String(key || "").toLowerCase();

  return (
    BLOCKED_KEYS.has(cleanKey) ||
    cleanKey.startsWith("$") ||
    cleanKey.includes(".")
  );
};

const stripHtml = (value, maxLength = MAX_STRING_LENGTH) => {
  return xss(String(value || "").trim(), {
    whiteList: {},
    stripIgnoreTag: true,
    stripIgnoreTagBody: ["script", "style", "iframe", "object"],
  })
    .replace(/\0/g, "")
    .slice(0, maxLength)
    .trim();
};

const sanitizeValue = (value, key = "", depth = 0) => {
  if (depth > MAX_DEPTH) {
    return undefined;
  }

  if (typeof value === "string") {
    if (isSensitiveKey(key)) {
      return value.slice(0, 1000);
    }

    return stripHtml(value);
  }

  if (typeof value === "number") {
    if (!Number.isFinite(value)) return 0;
    return value;
  }

  if (typeof value === "boolean" || value === null || value === undefined) {
    return value;
  }

  if (Array.isArray(value)) {
    return value
      .slice(0, 200)
      .map((item) => sanitizeValue(item, key, depth + 1))
      .filter((item) => item !== undefined);
  }

  if (value && typeof value === "object") {
    return sanitizeObject(value, depth + 1);
  }

  return value;
};

const sanitizeObject = (obj, depth = 0) => {
  if (!obj || typeof obj !== "object" || Array.isArray(obj)) {
    return obj;
  }

  const cleanObject = {};

  Object.keys(obj).forEach((key) => {
    if (isBlockedKey(key)) {
      return;
    }

    const cleanValue = sanitizeValue(obj[key], key, depth);

    if (cleanValue !== undefined) {
      cleanObject[key] = cleanValue;
    }
  });

  return cleanObject;
};

const sanitizeRequest = (req, res, next) => {
  if (req.body && typeof req.body === "object") {
    req.body = sanitizeObject(req.body);
  }

  if (req.params && typeof req.params === "object") {
    req.params = sanitizeObject(req.params);
  }

  if (req.query && typeof req.query === "object") {
    Object.keys(req.query).forEach((key) => {
      if (isBlockedKey(key)) {
        delete req.query[key];
        return;
      }

      req.query[key] = sanitizeValue(req.query[key], key);
    });
  }

  next();
};

const globalLimiter = rateLimit({
  windowMs: 15 * 60 * 1000,
  limit: 500,
  standardHeaders: true,
  legacyHeaders: false,
  message: {
    message: "Too many requests. Please try again later.",
  },
});

const authLimiter = rateLimit({
  windowMs: 15 * 60 * 1000,
  limit: 20,
  standardHeaders: true,
  legacyHeaders: false,
  message: {
    message: "Too many authentication attempts. Please try again later.",
  },
});

const orderLimiter = rateLimit({
  windowMs: 10 * 60 * 1000,
  limit: 60,
  standardHeaders: true,
  legacyHeaders: false,
  message: {
    message: "Too many order requests. Please try again later.",
  },
});

const uploadLimiter = rateLimit({
  windowMs: 15 * 60 * 1000,
  limit: 30,
  standardHeaders: true,
  legacyHeaders: false,
  message: {
    message: "Too many upload requests. Please try again later.",
  },
});

module.exports = {
  sanitizeRequest,
  globalLimiter,
  authLimiter,
  orderLimiter,
  uploadLimiter,
  stripHtml,
};
